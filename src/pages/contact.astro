---
import Base from '../layouts/Base.astro';
---

<Base title="Get in Touch" description="Request a walkthrough with Filthy Rich Soil Co. — whole-property regenerative land stewardship for estates in Chester County, PA.">

<style is:global>
  /* ── Hero ─────────────────────────────────── */
  .consult-hero {
    position: relative;
    min-height: 58vh;
    display: flex;
    align-items: flex-end;
    padding: 80px 5% 80px;
    background-image: url('https://images.unsplash.com/photo-1416879595882-3373a0480b5b?auto=format&fit=crop&w=1800&q=80');
    background-size: cover;
    background-position: center;
    background-attachment: fixed;
  }
  .consult-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(1,20,10,0.92) 0%, rgba(1,20,10,0.5) 55%, transparent 100%);
  }
  .consult-hero .hero-content { position: relative; z-index: 1; max-width: 640px; }
  .consult-hero .hero-eyebrow {
    font-size: 0.72rem; font-weight: 600;
    text-transform: uppercase; letter-spacing: 2.5px;
    color: var(--gold-lite); margin-bottom: 18px;
  }
  .consult-hero h1 {
    font-family: 'Playfair Display', serif;
    font-size: clamp(2.8rem, 5.5vw, 5rem);
    font-weight: 900; font-style: italic;
    color: #FAF7F0; line-height: 1.05; margin-bottom: 20px;
  }
  .consult-hero p {
    font-size: 1.1rem; font-weight: 300;
    color: rgba(250,247,240,0.75); max-width: 520px; line-height: 1.75;
  }

  /* ── How it works ─────────────────────────── */
  .how-section {
    background: #080e08;
    padding: 90px 5% 30px;
  }
  .how-inner { max-width: 1000px; margin: 0 auto; text-align: center; }
  .how-inner .section-eyebrow { justify-content: center; }
  .how-steps {
    display: grid; grid-template-columns: repeat(3, 1fr);
    gap: 40px; margin-top: 56px; text-align: left;
  }
  .how-step { position: relative; padding-top: 8px; }
  .how-step .step-num {
    font-family: 'Playfair Display', serif; font-style: italic;
    font-size: 2.6rem; font-weight: 900;
    color: rgba(184,134,11,0.28);
    line-height: 1; margin-bottom: 18px; display: block;
  }
  .how-step h3 {
    font-family: 'Playfair Display', serif;
    font-size: 1.3rem; color: #FAF7F0; margin-bottom: 12px;
  }
  .how-step p {
    font-size: 0.95rem; color: rgba(250,247,240,0.6); line-height: 1.8;
  }

  /* ── Form ─────────────────────────────────── */
  .consult-section {
    background: #080e08;
    padding: 60px 5% 110px;
  }
  .consult-inner { max-width: 680px; margin: 0 auto; }

  .consult-form {
    background: rgba(1,30,16,0.55);
    border: 1px solid rgba(184,134,11,0.18);
    border-radius: 14px; padding: 52px 52px 56px;
    backdrop-filter: blur(14px);
  }

  .form-row { margin-bottom: 28px; }
  .form-row label {
    display: block;
    font-size: 0.68rem; font-weight: 600;
    text-transform: uppercase; letter-spacing: 1.8px;
    color: rgba(250,247,240,0.5); margin-bottom: 10px;
  }
  .form-row input,
  .form-row textarea {
    width: 100%; box-sizing: border-box;
    background: rgba(1,20,10,0.6);
    border: 1px solid rgba(184,134,11,0.22);
    border-radius: 8px;
    color: #FAF7F0;
    font-family: 'DM Sans', sans-serif; font-size: 0.95rem;
    padding: 14px 18px;
    outline: none;
    transition: border-color 0.2s, background 0.2s;
    -webkit-appearance: none; appearance: none;
  }
  .form-row textarea { resize: vertical; min-height: 120px; line-height: 1.65; }
  .form-row input:focus,
  .form-row textarea:focus {
    border-color: #B8860B;
    background: rgba(1,30,16,0.75);
  }
  .form-row input::placeholder,
  .form-row textarea::placeholder { color: rgba(250,247,240,0.28); }

  .form-cols { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }

  /* ── Callback toggle ──────────────────────── */
  .callback-toggle {
    display: flex; align-items: flex-start; gap: 14px;
    background: rgba(1,20,10,0.5);
    border: 1px solid rgba(184,134,11,0.18);
    border-radius: 10px; padding: 18px 20px;
    margin-bottom: 28px; cursor: pointer;
    transition: border-color 0.2s, background 0.2s;
  }
  .callback-toggle:hover { border-color: rgba(184,134,11,0.4); }
  .callback-toggle input { margin-top: 3px; width: 18px; height: 18px; accent-color: #B8860B; cursor: pointer; flex-shrink: 0; }
  .callback-toggle .toggle-text strong {
    display: block; color: #FAF7F0; font-size: 0.92rem; font-weight: 600; margin-bottom: 4px;
  }
  .callback-toggle .toggle-text span {
    font-size: 0.82rem; color: rgba(250,247,240,0.5); line-height: 1.6;
  }

  .form-submit {
    margin-top: 10px; width: 100%;
    background: #013220; border: 1.5px solid #B8860B;
    color: #FAF7F0; border-radius: 100px;
    font-family: 'DM Sans', sans-serif; font-size: 0.75rem; font-weight: 700;
    text-transform: uppercase; letter-spacing: 2px;
    padding: 17px 0; cursor: pointer;
    transition: background 0.25s, transform 0.2s, box-shadow 0.2s;
  }
  .form-submit:hover {
    background: #024a30; transform: translateY(-2px);
    box-shadow: 0 10px 32px rgba(0,0,0,0.4);
  }

  .form-note {
    text-align: center; margin-top: 20px;
    font-size: 0.78rem; color: rgba(250,247,240,0.3); line-height: 1.6;
  }
  .form-note a { color: rgba(212,160,23,0.7); text-decoration: none; }
  .form-note a:hover { color: var(--gold-lite); }

  .form-success {
    display: none; text-align: center; padding: 48px 0;
  }
  .form-success .check { font-size: 2.5rem; margin-bottom: 16px; display: block; }
  .form-success h3 {
    font-family: 'Playfair Display', serif; font-style: italic;
    font-size: 1.6rem; color: #FAF7F0; margin-bottom: 12px;
  }
  .form-success p { font-size: 0.95rem; color: rgba(250,247,240,0.55); line-height: 1.75; }

  @media (max-width: 820px) {
    .how-steps { grid-template-columns: 1fr; gap: 44px; }
  }
  @media (max-width: 700px) {
    .consult-form { padding: 36px 28px 40px; }
    .form-cols { grid-template-columns: 1fr; gap: 0; }
    .consult-hero { background-attachment: scroll; }
  }
</style>

<!-- ── Hero ─────────────────────────────────── -->
<section class="consult-hero">
  <div class="hero-content">
    <p class="hero-eyebrow">Get in Touch</p>
    <h1>Let's walk your land.</h1>
    <p>Tell us a little about your property. We'll be in touch to set up a walkthrough — thirty minutes, no charge, no report. We look at your land with you and tell you honestly what we see.</p>
  </div>
</section>

<!-- ── Form ─────────────────────────────────── -->
<section class="consult-section">
  <div class="consult-inner">

    <div class="form-success" id="form-success">
      <span class="check">✓</span>
      <h3>Request received.</h3>
      <p>Thank you — we read every request personally and will be in touch to set up a visit.</p>
    </div>

    <form id="consult-form" class="consult-form reveal" action="https://formspree.io/f/meelylja" method="POST">

      <div class="form-cols">
        <div class="form-row">
          <label for="name">Full name</label>
          <input type="text" id="name" name="name" placeholder="Jane Smith" required />
        </div>
        <div class="form-row">
          <label for="email">Email address</label>
          <input type="email" id="email" name="email" placeholder="jane@example.com" required />
        </div>
      </div>

      <div class="form-cols">
        <div class="form-row">
          <label for="phone">Phone <span style="text-transform:none;letter-spacing:0;color:rgba(250,247,240,0.3);">(optional)</span></label>
          <input type="tel" id="phone" name="phone" placeholder="(610) 555-0100" />
        </div>
        <div class="form-row">
          <label for="property">Property town and approximate size</label>
          <input type="text" id="property" name="property" placeholder="West Chester — about 2 acres" required />
        </div>
      </div>

      <div class="form-row">
        <label for="message">Tell us about your land</label>
        <textarea id="message" name="message" placeholder="What's on the property, what's bothering you about it, and what you'd like it to become. If someone referred you, let us know who — it helps us understand what you're expecting." required></textarea>
      </div>

      <label class="callback-toggle">
        <input type="checkbox" id="callback" name="callback" value="Yes — please call me back" />
        <span class="toggle-text">
          <strong>Prefer a call back?</strong>
          <span>We can't always catch unknown numbers live, but we return every request. Check this and we'll call you.</span>
        </span>
      </label>

      <!-- Honeypot spam trap — hidden from real users -->
      <input type="text" name="_gotcha" style="display:none" tabindex="-1" autocomplete="off" />
      <input type="hidden" name="_subject" value="Walkthrough Request — Filthy Rich Soil Co." />

      <button type="submit" class="form-submit">Request a Walkthrough</button>
      <p class="form-note">
        Prefer email? Reach us directly at <a href="mailto:dan@filthyrichsoilco.com">dan@filthyrichsoilco.com</a>.
      </p>
      <p style="font-size:0.72rem;color:rgba(255,255,255,0.22);line-height:1.65;margin-top:16px;text-align:center;">
        By submitting, you agree to our <a href="/privacy" style="color:rgba(255,255,255,0.35);text-decoration:underline;">Privacy Policy</a> and <a href="/terms" style="color:rgba(255,255,255,0.35);text-decoration:underline;">Terms of Use</a>.
      </p>
    </form>

  </div>
</section>

<script>
  const form = document.getElementById('consult-form') as HTMLFormElement;
  const callback = document.getElementById('callback') as HTMLInputElement;
  const phone = document.getElementById('phone') as HTMLInputElement;

  // If they want a callback, we need a number to call.
  callback?.addEventListener('change', () => {
    phone.required = callback.checked;
    phone.previousElementSibling!.innerHTML = callback.checked
      ? 'Phone <span style="text-transform:none;letter-spacing:0;color:#d4a017;">(needed for a callback)</span>'
      : 'Phone <span style="text-transform:none;letter-spacing:0;color:rgba(250,247,240,0.3);">(optional)</span>';
  });

  // Formspree AJAX submit — keeps user on the page
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = form.querySelector('.form-submit') as HTMLButtonElement;
    btn.textContent = 'Sending…';
    btn.disabled = true;
    try {
      const res = await fetch(form.action, {
        method: 'POST',
        body: new FormData(form),
        headers: { Accept: 'application/json' },
      });
      if (res.ok) {
        form.style.display = 'none';
        const success = document.getElementById('form-success') as HTMLElement;
        success.style.display = 'block';
        success.scrollIntoView({ behavior: 'smooth', block: 'center' });
      } else {
        btn.textContent = 'Something went wrong — try again';
        btn.disabled = false;
      }
    } catch (_e) {
      btn.textContent = 'Something went wrong — try again';
      btn.disabled = false;
    }
  });
</script>

</Base>
