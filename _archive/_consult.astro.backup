        <button class="flow-option" data-action="select" data-key="decision" data-val="joint" data-next="fs-dd-contact"><span class="opt-icon">👫</span><span class="opt-label">Joint family decision<span class="opt-sub">Spouse, partner, or family</span></span></button>
        <button class="flow-option" data-action="select" data-key="decision" data-val="manager" data-next="fs-dd-contact"><span class="opt-icon">📋</span><span class="opt-label">Property or farm manager<span class="opt-sub">Managing on behalf of owner</span></span></button>
