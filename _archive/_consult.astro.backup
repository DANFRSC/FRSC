      <div class="step-number">Step 11 of 11</div>
      <h2>Let's build your stewardship profile</h2>
      <div class="step-desc">Almost ready — we'll generate your full custom document.</div>
      <div class="flow-form-row">
        <div class="flow-form-group"><label>First Name</label><input type="text" id="ddFirst" placeholder="Jane"></div>
        <div class="flow-form-group"><label>Last Name</label><input type="text" id="ddLast" placeholder="Smith"></div>
      </div>
      <div class="flow-form-group"><label>Email Address</label><input type="email" id="ddEmail" placeholder="jane@email.com"></div>
      <div class="flow-form-group"><label>Phone (optional)</label><input type="tel" id="ddPhone" placeholder="(610) 555-0100"></div>
      <div class="flow-form-group"><label>Property address or town</label><input type="text" id="ddAddr" placeholder="123 Farm Rd, Malvern, PA"></div>
      <div class="flow-form-group"><label>Anything else we should know? (optional)</label><textarea id="ddNotes" rows="3" placeholder="Specific history, challenges, or context about the property..."></textarea></div>
      <p class="form-error" id="ddErr">Please enter your name and email so your Lead Steward can reach you.</p>
      <button class="flow-btn" id="btn-dd-generate">Generate My Profile →</button>
    </div>

    <!-- ══ SHARED: Result ══ -->
    <div class="flow-step" id="fs-result">
      <div class="result-card">
        <span class="result-badge">Your Estimate</span>
        <div class="result-price"><sup>$</sup><span id="resultWeekly">155</span><span class="unit">/week</span></div>
        <div class="result-season">Based on a 36-week season</div>
        <div class="result-annual" id="resultAnnual"></div>
      </div>
      <div style="background:rgba(184,134,11,0.08);border:1px solid rgba(184,134,11,0.25);border-radius:10px;padding:12px 16px;margin-bottom:12px;">
        <p style="font-size:0.82rem;color:rgba(255,255,255,0.6);line-height:1.6;margin:0;"><strong style="color:#d4a017;">Your stewardship profile is ready.</strong> Side-by-side service comparison, inclusions, and your 3-year roadmap.</p>
      </div>
      <button class="flow-btn" id="btn-profile">Open Your Stewardship Profile →</button>
      <p style="font-size:0.78rem;color:#5fa870;font-weight:600;text-align:center;margin:12px 0 4px;letter-spacing:0.3px;">✓ Details sent to your Lead Steward — expect a reply within 24 hours.</p>
      <p style="font-size:0.62rem;color:rgba(255,255,255,0.2);line-height:1.5;margin-top:8px;text-align:center;">Estimate is informational only, not a binding offer. Final pricing confirmed after on-site assessment. By submitting you agree to our <a href="/privacy" style="color:rgba(255,255,255,0.3);text-decoration:underline;">Privacy Policy</a> & <a href="/terms" style="color:rgba(255,255,255,0.3);text-decoration:underline;">Terms</a>.</p>
      <button class="flow-btn ghost" id="btn-done" style="margin-top:8px;">Done</button>
    </div>

  </div>

  <div class="flow-bottombar">
    <button class="flow-back-btn hidden" id="backBtn">← Back</button>
    <div class="flow-step-label" id="stepLabel">Step 1</div>
  </div>
</div>

<script is:inline>
(function() {
  var data = {};
  var sets = { problems: new Set(), services: new Set(), ddservices: new Set(), challenges: new Set(), goals: new Set(), savings: new Set() };
  var navHistory = [];
  var currentStep = null;
  var mode = 'qq'; // 'qq' or 'dd'

  var weeklyFloor = { small:95, quarter:120, half:155, acre:220, large:355 };
  var SEASON_WEEKS = 36;

  // Progress percentages per step per mode
  var progressQQ = { 'fs-type':0,'fs-size-res':14,'fs-size-com':14,'fs-size-land':14,'fs-problems':28,'fs-qq-services':43,'fs-timeline':57,'fs-savings':71,'fs-qq-contact':85,'fs-result':100 };
  var progressDD = { 'fs-type':0,'fs-size-res':9,'fs-size-com':9,'fs-size-land':9,'fs-landuse':18,'fs-challenges':27,'fs-dd-services':36,'fs-setup':45,'fs-spend':54,'fs-goals':63,'fs-savings':72,'fs-decision':81,'fs-dd-contact':90,'fs-result':100 };

  var filterConfig = {
    residential: {
      probOrder: ['prob-soil','prob-water','prob-ecology'], probHideChips: ['pasture'], probHideGroups: [],
      svcOrder: ['turf','design','habitat','farm'], svcHideChips: ['pasture','hay'], svcHideGroups: ['farm'],
      challOrder: ['chall-soil','chall-water','chall-results','chall-land'], challHideChips: ['pasture','hay'], challHideGroups: [],
      badge: '<span>🏠</span> Tailored for residential'
    },
    commercial: {
      probOrder: ['prob-soil','prob-water','prob-ecology'], probHideChips: ['pasture'], probHideGroups: [],
      svcOrder: ['turf','design','habitat','farm'], svcHideChips: ['pasture','hay'], svcHideGroups: ['farm'],
      challOrder: ['chall-soil','chall-water','chall-results','chall-land'], challHideChips: ['pasture','hay'], challHideGroups: [],
      badge: '<span>🏢</span> Tailored for commercial'
    },
    estate: {
      probOrder: ['prob-water','prob-ecology','prob-soil'], probHideChips: [], probHideGroups: [],
      svcOrder: ['design','habitat','turf','farm'], svcHideChips: [], svcHideGroups: [],
      challOrder: ['chall-water','chall-land','chall-soil','chall-results'], challHideChips: [], challHideGroups: [],
      badge: '<span>🌳</span> Tailored for estate'
    },
    farm: {
      probOrder: ['prob-ecology','prob-soil','prob-water'], probHideChips: ['trees'], probHideGroups: [],
      svcOrder: ['farm','habitat','turf','design'], svcHideChips: [], svcHideGroups: [],
      challOrder: ['chall-land','chall-soil','chall-water','chall-results'], challHideChips: [], challHideGroups: [],
      badge: '<span>🌾</span> Tailored for farm'
    }
  };

  var landing = document.getElementById('landing');
  var overlay = document.getElementById('flowOverlay');
  var progressFill = document.getElementById('progressFill');
  var stepLabel = document.getElementById('stepLabel');
  var backBtn = document.getElementById('backBtn');
  var flowContent = document.getElementById('flowContent');

  function openOverlay() { landing.style.display = 'none'; overlay.classList.add('open'); }
  function closeOverlay() { overlay.classList.remove('open'); landing.style.display = ''; fullReset(); }

  function getProgress(id) { return (mode === 'dd' ? progressDD[id] : progressQQ[id]) || 0; }

  function goTo(id) {
    if (currentStep && currentStep !== id) navHistory.push(currentStep);
    currentStep = id;
    var allSteps = document.querySelectorAll('.flow-step');
    for (var i = 0; i < allSteps.length; i++) allSteps[i].classList.remove('active');
    var el = document.getElementById(id);
    if (el) { void el.offsetWidth; el.classList.add('active'); }
    progressFill.style.width = getProgress(id) + '%';
    var numEl = el ? el.querySelector('.step-number') : null;
    stepLabel.textContent = numEl ? numEl.textContent : (id === 'fs-result' ? 'Complete' : '');
    backBtn.className = 'flow-back-btn' + (navHistory.length === 0 ? ' hidden' : '');
    flowContent.scrollTop = 0;
  }

  function goBack() {
    if (navHistory.length === 0) return;
    var prev = navHistory.pop();
    currentStep = prev;
    var allSteps = document.querySelectorAll('.flow-step');
    for (var i = 0; i < allSteps.length; i++) allSteps[i].classList.remove('active');
    var el = document.getElementById(prev);
    if (el) el.classList.add('active');
    progressFill.style.width = getProgress(prev) + '%';
    var numEl = el ? el.querySelector('.step-number') : null;
    stepLabel.textContent = numEl ? numEl.textContent : '';
    backBtn.className = 'flow-back-btn' + (navHistory.length === 0 ? ' hidden' : '');
    flowContent.scrollTop = 0;
  }

  function fullReset() {
    navHistory = []; currentStep = null; data = {}; mode = 'qq';
    sets = { problems: new Set(), services: new Set(), ddservices: new Set(), challenges: new Set(), goals: new Set(), savings: new Set() };
    var sel = document.querySelectorAll('.chip.selected, .flow-option.selected');
    for (var i = 0; i < sel.length; i++) sel[i].classList.remove('selected');
    ['probCount','qqSvcCount','ddSvcCount','challCount','goalsCount','savCount'].forEach(function(id) { var el = document.getElementById(id); if (el) el.textContent = '0'; });
    ['qqFirst','qqLast','qqEmail','qqPhone','qqTown','ddFirst','ddLast','ddEmail','ddPhone','ddAddr','ddNotes'].forEach(function(id) { var el = document.getElementById(id); if (el) el.value = ''; });
    ['qqErr','ddErr'].forEach(function(id) { var el = document.getElementById(id); if (el) el.style.display = 'none'; });
    var hc = document.querySelectorAll('.hidden-chip'); for (var i = 0; i < hc.length; i++) hc[i].classList.remove('hidden-chip');
    var hg = document.querySelectorAll('.hidden-group'); for (var i = 0; i < hg.length; i++) hg[i].classList.remove('hidden-group');
    var rh = document.querySelectorAll('.route-hidden'); for (var i = 0; i < rh.length; i++) rh[i].classList.remove('route-hidden');
    progressFill.style.width = '0%';
    var allSteps = document.querySelectorAll('.flow-step');
    for (var i = 0; i < allSteps.length; i++) allSteps[i].classList.remove('active');
    document.getElementById('fs-type').classList.add('active');
  }

  function applySmartFilter(type) {
    var cfg = filterConfig[type];
    if (!cfg) return;
    // QQ problems
    reorderGroups('prob-groups', cfg.probOrder);
    hideChips('prob-groups', cfg.probHideChips);
    hideGroups('prob-groups', cfg.probHideGroups);
    document.getElementById('probBadge').innerHTML = cfg.badge;
    // QQ services
    reorderGroupsPrefix('qq-svc-groups', 'qqsvc-', cfg.svcOrder);
    hideChipsIn('qq-svc-groups', cfg.svcHideChips);
    hideGroupsPrefix('qq-svc-groups', 'qqsvc-', cfg.svcHideGroups);
    document.getElementById('qqSvcBadge').innerHTML = cfg.badge;
    // DD challenges
    reorderGroups('chall-groups', cfg.challOrder);
    hideChips('chall-groups', cfg.challHideChips);
    hideGroups('chall-groups', cfg.challHideGroups);
    document.getElementById('challBadge').innerHTML = cfg.badge;
    // DD services
    reorderGroupsPrefix('dd-svc-groups', 'ddsvc-', cfg.svcOrder);
    hideChipsIn('dd-svc-groups', cfg.svcHideChips);
    hideGroupsPrefix('dd-svc-groups', 'ddsvc-', cfg.svcHideGroups);
    document.getElementById('ddSvcBadge').innerHTML = cfg.badge;
    // Route-filter for land use + setup
    applyRouteFilter(type);
  }

  function reorderGroups(containerId, order) {
    var c = document.getElementById(containerId);
    for (var i = 0; i < order.length; i++) {
      var g = c.querySelector('[data-group="' + order[i] + '"]');
      if (g) c.appendChild(g);
    }
  }
  function reorderGroupsPrefix(containerId, prefix, order) {
    var c = document.getElementById(containerId);
    for (var i = 0; i < order.length; i++) {
      var g = c.querySelector('[data-group="' + prefix + order[i] + '"]');
      if (g) c.appendChild(g);
    }
  }
  function hideChips(containerId, vals) {
    var c = document.getElementById(containerId);
    var all = c.querySelectorAll('.chip.hidden-chip');
    for (var i = 0; i < all.length; i++) all[i].classList.remove('hidden-chip');
    for (var i = 0; i < vals.length; i++) {
      var ch = c.querySelector('.chip[data-val="' + vals[i] + '"]');
      if (ch) { ch.classList.add('hidden-chip'); ch.classList.remove('selected'); }
    }
  }
  function hideChipsIn(containerId, vals) { hideChips(containerId, vals); }
  function hideGroups(containerId, names) {
    var c = document.getElementById(containerId);
    var all = c.querySelectorAll('.chip-group.hidden-group');
    for (var i = 0; i < all.length; i++) all[i].classList.remove('hidden-group');
    for (var i = 0; i < names.length; i++) {
      var g = c.querySelector('[data-group="' + names[i] + '"]');
      if (g) g.classList.add('hidden-group');
    }
  }
  function hideGroupsPrefix(containerId, prefix, names) {
    var c = document.getElementById(containerId);
    var all = c.querySelectorAll('.chip-group.hidden-group');
    for (var i = 0; i < all.length; i++) all[i].classList.remove('hidden-group');
    for (var i = 0; i < names.length; i++) {
      var g = c.querySelector('[data-group="' + prefix + names[i] + '"]');
      if (g) g.classList.add('hidden-group');
    }
  }
  function applyRouteFilter(type) {
    var routed = document.querySelectorAll('.flow-option[data-route]');
    for (var i = 0; i < routed.length; i++) {
      var btn = routed[i];
      var routes = btn.getAttribute('data-route').split(' ');
      if (routes.indexOf(type) !== -1) btn.classList.remove('route-hidden');
      else { btn.classList.add('route-hidden'); btn.classList.remove('selected'); }
    }
  }

  function handleChipToggle(chip) {
    var setName = chip.getAttribute('data-set');
    var val = chip.getAttribute('data-val');
    var isExclusive = chip.getAttribute('data-exclusive') === 'true';
    var s = sets[setName];
    if (setName === 'problems' && isExclusive && !s.has(val)) {
      s.clear();
      var allC = document.querySelectorAll('.chip[data-set="problems"].selected');
      for (var i = 0; i < allC.length; i++) allC[i].classList.remove('selected');
    } else if (setName === 'problems' && !isExclusive && s.has('nothing')) {
      s.delete('nothing');
      var excl = document.querySelector('.chip[data-val="nothing"]');
      if (excl) excl.classList.remove('selected');
    }
    chip.classList.toggle('selected');
    if (s.has(val)) s.delete(val); else s.add(val);
    var counterMap = { problems:'probCount', services:'qqSvcCount', ddservices:'ddSvcCount', challenges:'challCount', goals:'goalsCount' };
    var cid = counterMap[setName];
    if (cid) document.getElementById(cid).textContent = s.size;
  }

  function handleToggle(btn) {
    var setName = btn.getAttribute('data-set');
    var val = btn.getAttribute('data-val');
    var counterId = btn.getAttribute('data-counter');
    var s = sets[setName];
    btn.classList.toggle('selected');
    if (s.has(val)) s.delete(val); else s.add(val);
    document.getElementById(counterId).textContent = s.size;
  }

  // Label mapping for Formspree
  var typeLabelsMailto = {residential:'Residential',farm:'Farm / Working Land',commercial:'Commercial',estate:'Estate / Large Residential'};
  var sizeLabelMailto  = {small:'Under ¼ acre',quarter:'¼–½ acre',half:'½–1 acre',acre:'1–3 acres',large:'3–5 acres',acres5:'5–10 acres',acres10:'10–25 acres',acres25:'25–50 acres',acres50:'50–100 acres',acres100:'100+ acres'};
  var timelineLabel    = {asap:'As soon as possible',season:'This season',next:'Next season',exploring:'Just exploring'};
  var partnerLabel     = {trainees:'Stewards in Training',content:'Property as Content',pilot:'Pilot Program Participant',flexible:'Full Scheduling Flexibility'};
  var svcNames = {
    turf:'Biological lawn & turf program', native:'Native plant design & installation',
    soil:'Soil testing & amendment program', water:'Drainage mapping & management',
    pasture:'Pasture rotation & livestock support', hay:'Hay field soil health & yield program',
    habitat:'Habitat corridors & wildlife planting', meadow:'Meadow & field conversion',
    woodland:'Woodland edge restoration', seasonal:'Year-round seasonal stewardship'
  };
  var sizeScale = {small:0.55,quarter:0.75,half:1.0,acre:1.45,large:2.3};
  var sizeLabel = {small:'Under ¼ acre',quarter:'¼–½ acre',half:'½–1 acre',acre:'1–3 acres',large:'3–5 acres',acres5:'5–10 acres',acres10:'10–25 acres',acres25:'25–50 acres',acres50:'50–100 acres',acres100:'100+ acres'};
  var svcRates = {
    turf:[1200,2400], native:[1500,3500], soil:[450,900],
    water:[800,2000], pasture:[1400,2800], hay:[900,1800],
    habitat:[600,1400], meadow:[1000,2200], woodland:[700,1400], seasonal:[1600,3200]
  };

  function submitToFormspree(submitMode) {
    var isDD = submitMode === 'dd';
    var svcs = isDD ? sets.ddservices : sets.services;
    var savs = sets.savings;
    var probs = isDD ? sets.challenges : sets.problems;
    var gls = sets.goals;
    var loc = isDD ? (data.address || 'Chester County, PA') : (data.town || 'Chester County, PA');

    var payload = {
      _subject: 'Consultation Request — ' + (typeLabelsMailto[data.type] || 'Property') + ', ' + loc,
      mode: isDD ? 'Full Discovery' : 'Quick Quote',
      name: ((data.firstName || '') + ' ' + (data.lastName || '')).trim(),
      email: data.email || '',
      phone: data.phone || 'Not provided',
      location: loc,
      property_type: typeLabelsMailto[data.type] || 'Not specified',
      property_size: sizeLabelMailto[data.size] || 'Not specified',
      estimate: data._weekly ? '$' + data._weekly + '/week · $' + (data._weekly * SEASON_WEEKS).toLocaleString() + '/season' : 'Custom quote — scoped on-site',
      services: svcs.size ? Array.from(svcs).map(function(s){ return svcNames[s] || s; }).join(', ') : 'To be discussed on-site',
      partnership_options: savs.size ? Array.from(savs).map(function(s){ return partnerLabel[s] || s; }).join(', ') : 'None selected',
      challenges: probs.size ? Array.from(probs).join(', ') : 'None specified'
    };
    if (!isDD) payload.timeline = timelineLabel[data.timeline] || 'Not specified';
    if (isDD) {
      payload.land_use = data.landuse || 'Not specified';
      payload.current_setup = data.setup || 'Not specified';
      payload.current_spend = data.spend || 'Not specified';
      payload.decision_maker = data.decision || 'Not specified';
      payload.ecological_goals = gls && gls.size ? Array.from(gls).join(', ') : 'Not specified';
      payload.notes = data.notes || '';
    }
    fetch('https://formspree.io/f/meelylja', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
      body: JSON.stringify(payload)
    }).catch(function(){});
  }

  function buildEmailHTML() {
    var isDD = mode === 'dd';
    var services = isDD ? sets.ddservices : sets.services;
    var savings = sets.savings;
    var sz = data.size || 'half';
    var scale = sizeScale[sz] || 1.0;
    var firstName = data.firstName || 'there';
    var location  = isDD ? (data.address || 'Chester County, PA') : (data.town || 'Chester County, PA');
    var weekly = data._weekly || (weeklyFloor[sz] || 155);
    var annual = weekly * SEASON_WEEKS;
    var isCustom = (data._weekly === null);
    var typeLabels = {residential:'Residential',farm:'Farm / Working Land',commercial:'Commercial',estate:'Estate / Large Residential'};
    var typeLabel  = typeLabels[data.type] || 'Property';

    // Base Living Grounds Program — always included, market comparison (market rate = piecemeal cost)
    var baseWeeklyMkt = {small:100, quarter:120, half:135, acre:165, large:230};
    var mktWeekly = baseWeeklyMkt[sz] || 135;
    var mktAnnual = mktWeekly * SEASON_WEEKS;
    var alwaysRows = [
      ['Lawn mowing (weekly / bi-weekly, biological practices)', Math.round(65*SEASON_WEEKS/100)*100, Math.round(85*SEASON_WEEKS/100)*100],
      ['Full-site organic fertilization program',                Math.round(15*SEASON_WEEKS/100)*100, Math.round(20*SEASON_WEEKS/100)*100],
      ['Invasive species management (ongoing)',                  Math.round(10*SEASON_WEEKS/100)*100, Math.round(15*SEASON_WEEKS/100)*100],
      ['Weed-free bed maintenance',                             Math.round(10*SEASON_WEEKS/100)*100, Math.round(15*SEASON_WEEKS/100)*100],
      ['Dedicated Lead Steward — single point of contact',        600, 1200]
    ];
    var alwaysLow  = 0, alwaysHigh = 0;
    alwaysRows.forEach(function(r){ alwaysLow += r[1]; alwaysHigh += r[2]; });

    // Selected service rows
    var svcRows = [];
    var svcLow = 0, svcHigh = 0;
    services.forEach(function(svc) {
      if (!svcRates[svc]) return;
      var lo = Math.round(svcRates[svc][0] * scale);
      var hi = Math.round(svcRates[svc][1] * scale);
      svcLow += lo; svcHigh += hi;
      svcRows.push([svcNames[svc] || svc, lo, hi]);
    });

    var totalLow  = alwaysLow  + svcLow;
    var totalHigh = alwaysHigh + svcHigh;

    // 3-year trajectory
    var dominant = Array.from(services)[0] || (isDD && (data.landuse === 'livestock' ? 'pasture' : data.landuse === 'hay' ? 'hay' : 'turf')) || 'turf';
    var trajs = {
      turf:    [['Year 1','Baseline soil testing and biological correction begins. Synthetic inputs stop. Earthworm and microbial activity assessment conducted.'],['Year 2','Turf density and color improve measurably. Input needs begin to decline. Annual soil report shows organic matter increase.'],['Year 3','Self-sustaining biological turf. Resilient to drought and disease. Program cost decreases as soil ecosystem matures.']],
      soil:    [['Year 1','Deep 4-layer soil profiling reveals limiting factors. Targeted amendments applied. Microbial inoculants introduced.'],['Year 2','Soil biology rebounds. pH stabilizes. Plant performance visibly improves across all zones.'],['Year 3','Living soil profile. Measurably higher organic matter. Annual inputs reduced by 25–40%.']],
      native:  [['Year 1','Site preparation and first native species established in priority zones. Invasive species addressed.'],['Year 2','Plants fill in and establish root systems. Pollinators begin returning. Species diversity increases.'],['Year 3','Mature native planting. Self-seeding begins in established zones. Near-zero maintenance required.']],
      water:   [['Year 1','Drainage mapping and root cause analysis. Infrastructure improvements and rain garden installation.'],['Year 2','Plant establishment around water features. Soil absorption and infiltration improve measurably.'],['Year 3','Functioning micro-watershed on-site. Flooding events significantly reduced. Erosion controlled.']],
      pasture: [['Year 1','Pasture soil testing and rotational grazing plan implemented. Rest periods established. Problem zones identified.'],['Year 2','Grass density and species diversity improve. Overworked zones recover. Hay quality rises alongside pasture health.'],['Year 3','Healthy, self-sustaining pasture. Livestock health indicators improve. Fertilizer input costs fall significantly.']],
      hay:     [['Year 1','Soil amendment program to correct pH and nutrient deficiencies specific to hay production. Base seeding if needed.'],['Year 2','Hay yield and quality measurably improve. Species composition shifts toward productive perennial grasses.'],['Year 3','Consistent, high-quality hay from biologically active soil. Synthetic fertilizer dependency eliminated.']],
      habitat: [['Year 1','Habitat corridor designed and initial native species established. First pollinator structures installed.'],['Year 2','First documented pollinators and birds in new habitat zones. Cover density increases substantially.'],['Year 3','Established, self-sustaining habitat. Native insect populations stabilizing. Property ecological identity clear.']],
      meadow:  [['Year 1','Existing vegetation assessed. Conversion zones prepared. Pioneer native species seeded.'],['Year 2','First full growing season of meadow growth. Weed pressure managed ecologically without herbicides.'],['Year 3','Meadow maturing and self-sustaining. Annual maintenance minimal in established zones.']],
      woodland:[['Year 1','Woodland edge assessed. Invasive removal begins. Native understory species planted.'],['Year 2','Invasive species reduce measurably. Native shrubs and groundcovers establishing throughout edge.'],['Year 3','Healthy layered woodland edge. Wildlife use visibly increased. Canopy succession underway.']],
      seasonal:[['Year 1','Full 18-visit program calibrated to ecological cues, not calendar dates. Baseline measurements taken.'],['Year 2','Seasonal patterns become visible. Interventions become more targeted and efficient. Cost per outcome falls.'],['Year 3','Program dialed in. Property runs on biological momentum. Steward visits shift to refinement and measurement.']],
      lowmaint:[['Year 1','Baseline assessment completed. Self-sufficient native species selected for your specific conditions. Irrigation-dependent plantings identified and transitioned.'],['Year 2','Established plantings begin to self-regulate. Intervention needs drop measurably. Mowing frequency reduced in converted zones.'],['Year 3','Mature, self-sustaining landscape. Seasonal care replaces reactive maintenance. Your property runs on ecological momentum — not constant inputs.']]
    };
    var roadmap = trajs[dominant] || trajs.turf;

    // Color palette
    var F = '#013220'; var G = '#B8860B'; var GL = '#d4a017'; var CR = '#FAF7F0'; var BG = '#080e08';

    function sc(lo, hi) { return '$' + Math.round(lo/100)*100 + '–$' + Math.round(hi/100)*100 + '/yr'; }

    var alwaysTableRows = alwaysRows.map(function(r){
      return '<tr><td style="padding:10px 14px;border-bottom:1px solid rgba(1,50,32,0.1);color:#374337;font-size:0.84rem;line-height:1.4;">' + r[0] + '</td>' +
             '<td style="padding:10px 14px;border-bottom:1px solid rgba(1,50,32,0.1);color:#666;font-size:0.84rem;white-space:nowrap;text-align:right;">$' + r[1].toLocaleString() + '–$' + r[2].toLocaleString() + '/yr</td>' +
             '<td style="padding:10px 14px;border-bottom:1px solid rgba(1,50,32,0.1);text-align:center;"><span style="color:' + F + ';font-weight:700;font-size:0.85rem;">✓ Always Included</span></td></tr>';
    }).join('');

    var svcTableRows = svcRows.length ? svcRows.map(function(r){
      return '<tr><td style="padding:10px 14px;border-bottom:1px solid rgba(1,50,32,0.08);color:#374337;font-size:0.84rem;line-height:1.4;">' + r[0] + '</td>' +
             '<td style="padding:10px 14px;border-bottom:1px solid rgba(1,50,32,0.08);color:#666;font-size:0.84rem;white-space:nowrap;text-align:right;">$' + r[1].toLocaleString() + '–$' + r[2].toLocaleString() + '/yr</td>' +
             '<td style="padding:10px 14px;border-bottom:1px solid rgba(1,50,32,0.08);text-align:center;"><span style="color:' + F + ';font-weight:700;font-size:0.85rem;">✓ Included</span></td></tr>';
    }).join('') : '<tr><td colspan="3" style="padding:10px 14px;color:#888;font-size:0.82rem;font-style:italic;">Services to be scoped during on-site assessment</td></tr>';

    var totalRow = '<tr style="background:rgba(1,50,32,0.06);">' +
      '<td style="padding:12px 14px;font-weight:700;color:' + F + ';font-size:0.88rem;">Total if purchased separately</td>' +
      '<td style="padding:12px 14px;font-weight:700;color:#cc2200;font-size:0.88rem;white-space:nowrap;text-align:right;">$' + totalLow.toLocaleString() + '–$' + totalHigh.toLocaleString() + '/yr</td>' +
      '<td style="padding:12px 14px;"></td></tr>';

    var frscRow = '<tr style="background:' + F + ';">' +
      '<td style="padding:14px 14px;font-weight:700;color:' + CR + ';font-size:0.9rem;">Filthy Rich Soil Co. — Living Grounds Program (all-inclusive)</td>' +
      '<td style="padding:14px 14px;text-align:right;"><span style="color:rgba(250,247,240,0.45);font-size:0.78rem;">$' + annual.toLocaleString() + '/season</span></td>' +
      '<td style="padding:14px 14px;text-align:center;"><span style="font-family:Georgia,serif;font-weight:900;color:' + G + ';font-size:1.15rem;">$' + weekly.toLocaleString() + '/wk</span></td></tr>';

    var roadmapHTML = roadmap.map(function(r, i){
      var labels = ['Year One','Year Two','Year Three'];
      return '<div style="display:flex;gap:18px;padding:16px 0;border-bottom:1px solid rgba(1,50,32,0.1);">' +
        '<div style="min-width:80px;font-family:Georgia,serif;font-weight:900;font-size:0.82rem;color:' + G + ';padding-top:2px;">' + labels[i] + '</div>' +
        '<div style="font-size:0.86rem;color:#444;line-height:1.72;">' + r[1] + '</div></div>';
    }).join('');

    var profileText = {
      low: "We'll identify the single highest-impact intervention for your budget and build from there. Starter programs focus on soil correction in one priority zone — small footprint, meaningful results that set the foundation for expansion.",
      mid: "Substantial enough to run a real soil health initiative alongside one or two priority service areas. Clients at this level see visible, measurable improvement by their second growing season — and costs start declining by Year 3.",
      high: "The full stewardship model. Comprehensive soil programs, native plant design, and multiple service areas running simultaneously. These are the transformations that make neighbors ask who your steward is.",
      premium: "Full ecological transformation. We become your land's long-term steward — designing, planting, monitoring, and evolving your property's ecosystem across every season, indefinitely. Farm programs, large-field management, and multi-zone estates."
    };

    return '<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Filthy Rich Soil Co. — Your Stewardship Profile</title>' +
    '<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,700;1,700;1,900&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">' +
    '<style>*{box-sizing:border-box;margin:0;padding:0;}body{font-family:"DM Sans",Georgia,sans-serif;background:#f0ece4;color:#2a2a2a;}@media print{body{background:white;}.no-print{display:none!important;}}</style>' +
    '</head><body>' +
    '<div style="max-width:720px;margin:0 auto;background:#fff;box-shadow:0 4px 40px rgba(0,0,0,0.12);">' +

    // Header
    '<div style="background:' + F + ';padding:32px 48px 28px;display:flex;justify-content:space-between;align-items:center;">' +
      '<div>' +
        '<div style="font-family:Georgia,serif;color:' + G + ';font-size:0.65rem;letter-spacing:3px;text-transform:uppercase;margin-bottom:5px;">Filthy Rich Soil Co.</div>' +
        '<div style="color:rgba(250,247,240,0.45);font-size:0.68rem;letter-spacing:1px;">Chester County, PA · Ecological Land Stewardship</div>' +
      '</div>' +
      '<div style="text-align:right;">' +
        '<div style="font-size:0.65rem;color:rgba(250,247,240,0.4);letter-spacing:0.5px;">dan@filthyrichsoilco.com</div>' +
        '<div style="font-size:0.65rem;color:rgba(250,247,240,0.4);margin-top:3px;">filthyrichsoilco.com</div>' +
      '</div>' +
    '</div>' +

    // Hero
    '<div style="background:' + BG + ';padding:44px 48px 40px;">' +
      '<div style="display:inline-block;background:rgba(184,134,11,0.2);border:1px solid rgba(184,134,11,0.35);border-radius:100px;padding:5px 16px;font-size:0.62rem;font-weight:600;letter-spacing:2px;text-transform:uppercase;color:' + GL + ';margin-bottom:18px;">' + typeLabel + ' · ' + sizeLabel[sz] + ' · Chester County, PA</div>' +
      '<h1 style="font-family:Georgia,serif;font-size:2.1rem;font-style:italic;font-weight:900;color:' + CR + ';line-height:1.15;margin-bottom:14px;">Hi ' + firstName + ' — here\'s<br>what we put together.</h1>' +
      '<p style="font-size:0.94rem;color:rgba(250,247,240,0.62);line-height:1.82;max-width:560px;">' + (isCustom ? 'Farm and commercial programs require an on-site assessment before we can build a proper proposal. A Lead Steward will reach out to schedule yours — no obligation.' : 'Based on your property, here\'s what a Living Grounds Program looks like for your land — base program, comparison to piecemeal, and your 3-year ecological roadmap.') + '</p>' +
    '</div>' +

    // Estimate band
    '<div style="background:' + F + ';padding:32px 48px;">' +
      (isCustom ?
        '<div style="font-size:0.62rem;font-weight:600;letter-spacing:2px;text-transform:uppercase;color:rgba(250,247,240,0.45);margin-bottom:8px;">Program Investment</div>' +
        '<div style="font-family:Georgia,serif;font-size:2rem;font-weight:900;color:' + CR + ';line-height:1.2;margin-bottom:10px;">Custom Quote — Scoped On-Site</div>' +
        '<div style="font-size:0.84rem;color:' + GL + ';line-height:1.6;">Farm and commercial programs vary widely based on acreage, land use, and goals. Your Lead Steward will build a proposal after the free on-site assessment.</div>'
      :
        '<div style="display:flex;align-items:flex-end;gap:32px;flex-wrap:wrap;">' +
          '<div>' +
            '<div style="font-size:0.62rem;font-weight:600;letter-spacing:2px;text-transform:uppercase;color:rgba(250,247,240,0.45);margin-bottom:8px;">Living Grounds Program</div>' +
            '<div style="display:flex;align-items:baseline;gap:8px;">' +
              '<div style="font-family:Georgia,serif;font-size:3.4rem;font-weight:900;color:' + CR + ';line-height:1;">$' + weekly.toLocaleString() + '</div>' +
              '<div style="font-size:1rem;color:rgba(250,247,240,0.55);font-weight:300;">/week</div>' +
            '</div>' +
            '<div style="font-size:0.82rem;color:' + GL + ';margin-top:6px;">$' + annual.toLocaleString() + ' per season &nbsp;·&nbsp; 36 weeks</div>' +
          '</div>' +
          '<div style="background:rgba(0,0,0,0.2);border-radius:10px;padding:14px 18px;">' +
            '<div style="font-size:0.6rem;color:rgba(250,247,240,0.38);letter-spacing:1px;text-transform:uppercase;margin-bottom:4px;">Location</div>' +
            '<div style="font-size:0.86rem;color:' + CR + ';font-weight:500;">' + location + '</div>' +
          '</div>' +
        '</div>' +
        '<div style="font-size:0.78rem;color:rgba(250,247,240,0.42);margin-top:14px;line-height:1.6;">Base program. Add-on services scoped separately. As soil ecology matures, the inputs your program requires can decrease — your Steward will discuss realistic cost trajectory at the site assessment.</div>'
      ) +
    '</div>' +

    // Comparison table (skip for custom quote)
    (!isCustom ? (
    '<div style="padding:44px 48px;background:#FAF7F0;">' +
      '<div style="font-size:0.62rem;font-weight:600;letter-spacing:2px;text-transform:uppercase;color:rgba(1,50,32,0.45);margin-bottom:6px;">The Real Cost Comparison</div>' +
      '<h2 style="font-family:Georgia,serif;font-size:1.55rem;font-style:italic;font-weight:700;color:' + F + ';margin-bottom:6px;">What 4 separate vendors would cost you</h2>' +
      '<p style="font-size:0.84rem;color:#666;line-height:1.7;margin-bottom:24px;">Most Chester County homeowners hire a mowing company, a fertilization service, a landscaper for beds, and handle weeds themselves — or pay a premium company to do all three. Here\'s what that stack actually costs compared to one weekly FRSC subscription.</p>' +
      '<table style="width:100%;border-collapse:collapse;background:white;border-radius:10px;overflow:hidden;box-shadow:0 1px 8px rgba(0,0,0,0.06);">' +
        '<thead><tr style="background:' + F + ';">' +
          '<th style="padding:12px 14px;text-align:left;font-size:0.65rem;letter-spacing:1.5px;text-transform:uppercase;color:rgba(250,247,240,0.6);font-weight:600;">Service</th>' +
          '<th style="padding:12px 14px;text-align:right;font-size:0.65rem;letter-spacing:1.5px;text-transform:uppercase;color:rgba(250,247,240,0.6);font-weight:600;white-space:nowrap;">Piecemeal Cost</th>' +
          '<th style="padding:12px 14px;text-align:center;font-size:0.65rem;letter-spacing:1.5px;text-transform:uppercase;color:rgba(250,247,240,0.6);font-weight:600;">With FRSC</th>' +
        '</tr></thead>' +
        '<tbody>' + alwaysTableRows + totalRow + frscRow + '</tbody>' +
      '</table>' +
      '<p style="font-size:0.74rem;color:#999;margin-top:10px;line-height:1.6;">Piecemeal estimates for Chester County, PA. The FRSC Living Grounds Program replaces this entire stack — one weekly rate, one relationship, one steward who knows your land.</p>' +
    '</div>'
    ) : '') +

    // Partnership section (only if any selected)
    (savings.size > 0 ? (function(){
      var partnerLabels = {
        trainees: {label:'Stewards in Training',        desc:'Allow supervised trainees to work alongside our senior Steward on your property. You receive the same expert oversight — they gain real-world experience in a professional setting.'},
        content:  {label:'Property as Content',         desc:'Allow us to document your property\'s transformation — video, photography, and soil data — for use in our educational content and media channels. Your identity stays private unless you choose otherwise.'},
        pilot:    {label:'Pilot Program Participant',   desc:'Open a section of your property as a living laboratory for new biological techniques we\'re developing. You receive full scientific documentation of what was tried, what worked, and what didn\'t.'},
        flexible: {label:'Full Scheduling Flexibility', desc:'Give us full flexibility on which weekday we visit — no day restrictions or preferred windows. This lets us build the most efficient route possible and pass the savings directly to you.'}
      };
      var discLevels = ['a meaningful discount','a significant discount','a substantial discount','our most significant available discount'];
      var count = savings.size;
      var discLabel = discLevels[Math.min(count - 1, 3)];
      var rows = '';
      savings.forEach(function(key){
        var p = partnerLabels[key];
        if (!p) return;
        rows += '<div style="display:flex;gap:16px;padding:16px 0;border-bottom:1px solid rgba(250,247,240,0.1);align-items:flex-start;">' +
          '<div style="min-width:28px;height:28px;border-radius:50%;background:' + G + ';display:flex;align-items:center;justify-content:center;font-size:0.7rem;color:' + BG + ';font-weight:900;flex-shrink:0;margin-top:2px;">✓</div>' +
          '<div><div style="font-weight:600;color:' + CR + ';font-size:0.88rem;margin-bottom:4px;">' + p.label + '</div>' +
          '<div style="font-size:0.82rem;color:rgba(250,247,240,0.58);line-height:1.68;">' + p.desc + '</div></div>' +
        '</div>';
      });
      return '<div style="padding:44px 48px;background:' + F + ';border-top:4px solid ' + G + ';">' +
        '<div style="font-size:0.62rem;font-weight:600;letter-spacing:2px;text-transform:uppercase;color:rgba(250,247,240,0.4);margin-bottom:6px;">Partnership Selected</div>' +
        '<h2 style="font-family:Georgia,serif;font-size:1.55rem;font-style:italic;font-weight:700;color:' + CR + ';margin-bottom:8px;">You\'ve opened the door to ' + discLabel + '.</h2>' +
        '<p style="font-size:0.84rem;color:rgba(250,247,240,0.58);line-height:1.7;margin-bottom:22px;">These aren\'t upsells — they\'re ways to deepen the relationship. The exact reduction on your stewardship rate will be confirmed on your consultation call.</p>' +
        rows +
        '<p style="font-size:0.74rem;color:rgba(250,247,240,0.3);margin-top:18px;line-height:1.6;">Partnership terms are finalized during the site assessment and formal proposal conversation.</p>' +
      '</div>';
    })() : '') +

    // What's included
    '<div style="padding:44px 48px;background:' + F + ';">' +
      '<div style="font-size:0.62rem;font-weight:600;letter-spacing:2px;text-transform:uppercase;color:rgba(250,247,240,0.4);margin-bottom:6px;">Living Grounds Program — Base</div>' +
      '<h2 style="font-family:Georgia,serif;font-size:1.55rem;font-style:italic;font-weight:700;color:' + CR + ';margin-bottom:8px;">Always included, every week</h2>' +
      '<p style="font-size:0.84rem;color:rgba(250,247,240,0.48);line-height:1.72;margin-bottom:20px;">This is the foundation of every FRSC program — not optional extras, not line-item add-ons. One rate, always covered.</p>' +
      '<div style="display:flex;flex-wrap:wrap;gap:8px;">' +
        ['Lawn mowing (biological practices)','Full-site organic fertilization','Invasive species management','Weed-free bed maintenance','Dedicated Lead Steward']
          .map(function(pill){ return '<span style="background:rgba(250,247,240,0.1);border:1px solid rgba(250,247,240,0.2);border-radius:100px;padding:6px 16px;font-size:0.76rem;color:rgba(250,247,240,0.8);">' + pill + '</span>'; })
          .join('') +
      '</div>' +
      (services.size > 0 ?
        '<div style="margin-top:22px;padding-top:22px;border-top:1px solid rgba(255,255,255,0.08);">' +
        '<div style="font-size:0.7rem;font-weight:600;letter-spacing:1px;text-transform:uppercase;color:rgba(250,247,240,0.35);margin-bottom:10px;">Add-on services you indicated interest in — scoped on-site</div>' +
        '<div style="display:flex;flex-wrap:wrap;gap:8px;">' +
          Array.from(services).map(function(s){ return '<span style="background:rgba(184,134,11,0.12);border:1px solid rgba(184,134,11,0.3);border-radius:100px;padding:6px 16px;font-size:0.76rem;color:' + GL + ';">' + (svcNames[s] || s) + '</span>'; }).join('') +
        '</div></div>'
      : '') +
      '<p style="font-size:0.82rem;color:rgba(250,247,240,0.42);margin-top:20px;line-height:1.72;">One contract. One steward. One weekly number. No surprise invoices, no seasonal add-ons, no coordination overhead.</p>' +
    '</div>' +

    // 3-year roadmap
    '<div style="padding:44px 48px;background:white;">' +
      '<div style="font-size:0.62rem;font-weight:600;letter-spacing:2px;text-transform:uppercase;color:rgba(1,50,32,0.45);margin-bottom:6px;">What to Expect</div>' +
      '<h2 style="font-family:Georgia,serif;font-size:1.55rem;font-style:italic;font-weight:700;color:' + F + ';margin-bottom:4px;">Your 3-year ecological roadmap</h2>' +
      '<p style="font-size:0.84rem;color:#666;line-height:1.7;margin-bottom:22px;">Based on your priority service focus. Your formal program roadmap will be built after the on-site soil assessment.</p>' +
      roadmapHTML +
    '</div>' +

    // Next steps
    '<div style="padding:44px 48px;background:#FAF7F0;">' +
      '<div style="font-size:0.62rem;font-weight:600;letter-spacing:2px;text-transform:uppercase;color:rgba(1,50,32,0.45);margin-bottom:6px;">What Happens Next</div>' +
      '<h2 style="font-family:Georgia,serif;font-size:1.55rem;font-style:italic;font-weight:700;color:' + F + ';margin-bottom:24px;">From here to your first season</h2>' +
      [['Your Lead Steward reaches out within 24 hours','A real phone call or email — not an automated sequence. They\'ll answer any questions about this profile and confirm your free site assessment.'],
       ['Free on-site soil assessment','Your Lead Steward walks the property with you. They read the land in person — soil samples, drainage patterns, current plant health, and what your specific site needs.'],
       ['Your custom stewardship proposal','After the site visit, you receive a formal program proposal: ecological goals, specific services, seasonal schedule, and your all-inclusive annual number.'],
       ['You decide — no pressure','We only take on properties we believe we can meaningfully improve. If it\'s not the right fit on either side, we\'ll be honest about it.']]
        .map(function(step, i){
          return '<div style="display:flex;gap:20px;margin-bottom:22px;align-items:flex-start;">' +
            '<div style="min-width:36px;height:36px;border-radius:50%;background:' + F + ';display:flex;align-items:center;justify-content:center;font-family:Georgia,serif;font-weight:900;color:' + G + ';font-size:0.9rem;flex-shrink:0;margin-top:2px;">' + (i+1) + '</div>' +
            '<div><div style="font-weight:600;color:' + F + ';font-size:0.9rem;margin-bottom:4px;">' + step[0] + '</div><div style="font-size:0.82rem;color:#666;line-height:1.72;">' + step[1] + '</div></div>' +
          '</div>';
        }).join('') +
    '</div>' +

    // Footer
    '<div style="background:' + F + ';padding:32px 48px;text-align:center;">' +
      '<div style="font-family:Georgia,serif;color:' + G + ';font-size:0.75rem;letter-spacing:2.5px;text-transform:uppercase;margin-bottom:8px;">Filthy Rich Soil Co.</div>' +
      '<div style="color:rgba(250,247,240,0.45);font-size:0.72rem;margin-bottom:4px;">Chester County, PA · Ecological Land Stewardship</div>' +
      '<div style="color:rgba(250,247,240,0.4);font-size:0.72rem;">dan@filthyrichsoilco.com · filthyrichsoilco.com</div>' +
      '<div style="margin-top:20px;padding-top:20px;border-top:1px solid rgba(255,255,255,0.08);font-size:0.65rem;color:rgba(255,255,255,0.25);line-height:1.7;">This stewardship profile was generated based on your consultation inputs and represents an initial program estimate. Final pricing is confirmed after the on-site soil assessment and formal proposal. All programs are all-inclusive — no add-on charges for standard services.</div>' +
    '</div>' +

    '</div></body></html>';
  }

  function openEmailPreview() {
    var html = buildEmailHTML();
    var blob = new Blob([html], {type:'text/html'});
    window.open(URL.createObjectURL(blob), '_blank');
  }

  function showResult(isDD) {
    var prefix = isDD ? 'dd' : 'qq';
    var errEl = document.getElementById(prefix + 'Err');
    errEl.style.display = 'none';
    var firstName = document.getElementById(prefix + 'First').value.trim();
    var email = document.getElementById(prefix + 'Email').value.trim();
    if (!firstName || !email) { errEl.style.display = 'block'; return; }
    data.firstName = firstName;
    data.lastName = document.getElementById(prefix + 'Last').value.trim();
    data.email = email;
    data.phone = document.getElementById(prefix + 'Phone').value.trim();
    if (isDD) {
      data.address = document.getElementById('ddAddr').value.trim();
      data.notes = document.getElementById('ddNotes').value.trim();
    } else {
      data.town = document.getElementById('qqTown').value.trim() || 'Chester County, PA';
    }
    var sz = data.size || 'half';
    var isCustom = (data.type === 'commercial' || data.type === 'farm' || sz.indexOf('acres') === 0);
    if (isCustom) {
      data._weekly = null;
      document.getElementById('resultWeekly').textContent = 'Custom';
      document.getElementById('resultAnnual').textContent = 'Farm, estate & commercial programs are scoped on-site — your Steward will build a custom proposal.';
    } else {
      var weekly = weeklyFloor[sz] || (isDD ? 155 : 95);
      var annual = weekly * SEASON_WEEKS;
      data._weekly = weekly;
      document.getElementById('resultWeekly').textContent = weekly.toLocaleString();
      document.getElementById('resultAnnual').textContent = '$' + annual.toLocaleString() + ' / season · 36 weeks';
    }
    goTo('fs-result');
    submitToFormspree(isDD ? 'dd' : 'qq');
  }

  // Update step numbers on shared steps that differ between QQ and DD
  function updateSharedStepNumbers() {
    var total = mode === 'dd' ? '11' : '7';
    var snType = document.getElementById('sn-type');
    var snSav  = document.getElementById('sn-savings');
    if (snType) snType.textContent = 'Step 1 of ' + total;
    if (snSav)  snSav.textContent  = mode === 'dd' ? 'Step 9 of 11' : 'Step 6 of 7';
    // Update size step numbers too
    var sizeSteps = document.querySelectorAll('#fs-size-res .step-number, #fs-size-com .step-number, #fs-size-land .step-number');
    for (var i = 0; i < sizeSteps.length; i++) sizeSteps[i].textContent = 'Step 2 of ' + total;
  }

  // After size selection, route to the right next step based on mode
  function afterSize(sizeVal) {
    data.size = sizeVal;
    if (mode === 'dd') goTo('fs-landuse');
    else goTo('fs-problems');
  }

  document.addEventListener('click', function(e) {
    var target = e.target.closest('[data-action], [id]');
    if (!target) return;
    var action = target.getAttribute('data-action');
    var id = target.id;

    if (id === 'btn-qq') { mode = 'qq'; data._mode = 'qq'; updateSharedStepNumbers(); openOverlay(); goTo('fs-type'); return; }
    if (id === 'btn-dd') { mode = 'dd'; data._mode = 'dd'; updateSharedStepNumbers(); openOverlay(); goTo('fs-type'); return; }
    if (id === 'btn-close' || id === 'btn-done') { closeOverlay(); return; }
    if (id === 'backBtn') { goBack(); return; }
    if (id === 'btn-qq-generate') { showResult(false); return; }
    if (id === 'btn-dd-generate') { showResult(true); return; }
    if (id === 'btn-profile') { openEmailPreview(); return; }
    if (id === 'btn-savings-continue') {
      if (mode === 'dd') goTo('fs-decision');
      else goTo('fs-qq-contact');
      return;
    }

    if (action === 'select-type') {
      var val = target.getAttribute('data-val');
      var next = target.getAttribute('data-next');
      data.type = val;
      applySmartFilter(val);
      target.classList.add('selected');
      setTimeout(function() { goTo(next); }, 180);
      return;
    }
    if (action === 'select-size') {
      target.classList.add('selected');
      var val = target.getAttribute('data-val');
      setTimeout(function() { afterSize(val); }, 180);
      return;
    }
    if (action === 'select') {
      data[target.getAttribute('data-key')] = target.getAttribute('data-val');
      target.classList.add('selected');
      var next = target.getAttribute('data-next');
      setTimeout(function() { goTo(next); }, 180);
      return;
    }
    if (action === 'chip-toggle') { handleChipToggle(target); return; }
    if (action === 'toggle') { handleToggle(target); return; }
    if (action === 'goto') { goTo(target.getAttribute('data-next')); return; }
  });

  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') closeOverlay();
    if (e.key === 'Backspace') {
      var tag = document.activeElement.tagName;
      if (tag !== 'INPUT' && tag !== 'TEXTAREA' && tag !== 'SELECT') { e.preventDefault(); goBack(); }
    }
  });
})();
</script>

</Base>
