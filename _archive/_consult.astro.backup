        <button class="flow-option" data-action="select" data-key="spend" data-val="high" data-next="fs-goals"><span class="opt-icon">💰</span><span class="opt-label">$7,500 – $15,000</span></button>
        <button class="flow-option" data-action="select" data-key="spend" data-val="premium" data-next="fs-goals"><span class="opt-icon">💎</span><span class="opt-label">$15,000+ / yr</span></button>
        <button class="flow-option" data-action="select" data-key="spend" data-val="unsure" data-next="fs-goals"><span class="opt-icon">🤷</span><span class="opt-label">Not sure</span></button>
