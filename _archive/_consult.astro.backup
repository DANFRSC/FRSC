      <div class="flow-form-group"><label>Phone (optional)</label><input type="tel" id="qqPhone" placeholder="(610) 555-0100"></div>
      <div class="flow-form-group"><label>Town or municipality</label><input type="text" id="qqTown" placeholder="Malvern, PA"></div>
      <p class="form-error" id="qqErr">Please enter your name and email so your Lead Steward can reach you.</p>
      <button class="flow-btn" id="btn-qq-generate">Generate My Profile →</button>
    </div>

    <!-- ══ DD: Contact (expanded) ══ -->
