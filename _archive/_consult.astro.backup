        <button class="flow-option" data-action="select" data-key="setup" data-val="mowing" data-next="fs-spend"><span class="opt-icon">🚜</span><span class="opt-label">Basic mowing service only<span class="opt-sub">Cuts the grass, nothing more</span></span></button>
        <button class="flow-option" data-action="select" data-key="setup" data-val="fullservice" data-next="fs-spend"><span class="opt-icon">🏢</span><span class="opt-label">Full-service landscape company<span class="opt-sub">One company, multiple services</span></span></button>
        <button class="flow-option" data-action="select" data-key="setup" data-val="multi" data-next="fs-spend"><span class="opt-icon">👥</span><span class="opt-label">Multiple separate vendors<span class="opt-sub">Mowing + fert + others</span></span></button>
        <button class="flow-option" data-action="select" data-key="setup" data-val="hoa" data-next="fs-spend" data-route="residential commercial"><span class="opt-icon">🏘️</span><span class="opt-label">HOA or property management<span class="opt-sub">Managed through association</span></span></button>
        <button class="flow-option" data-action="select" data-key="setup" data-val="consultant" data-next="fs-spend" data-route="farm estate"><span class="opt-icon">📋</span><span class="opt-label">Farm management consultant<span class="opt-sub">Agronomist or farm advisor</span></span></button>
        <button class="flow-option" data-action="select" data-key="setup" data-val="none" data-next="fs-spend"><span class="opt-icon">🌱</span><span class="opt-label">No current service<span class="opt-sub">Starting from scratch</span></span></button>
