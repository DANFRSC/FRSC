---
import Base from '../layouts/Base.astro';
---

<Base title="Begin Consultation" description="Start your Filthy Rich Soil Co. consultation. Quick Quote or Full Discovery — find out exactly what your property needs and what it will cost.">

<style is:global>
  :root {
    --forest: #013220; --forest-mid: #024d32;
    --gold: #B8860B; --gold-lite: #d4a017;
    --cream: #FAF7F0; --bg-dark: #080e08; --bg-card: #0a140a;
  }
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  html { scroll-behavior: smooth; }
  body { font-family: 'DM Sans', sans-serif; background: var(--bg-dark); color: var(--cream); overflow-x: hidden; min-height: 100vh; }

  /* ── LANDING ── */
  .landing {
    min-height: 100vh; display: flex; flex-direction: column; align-items: center; justify-content: center;
    text-align: center; padding: 40px 24px;
    background: linear-gradient(180deg, rgba(0,0,0,0.3) 0%, var(--bg-dark) 100%),
                url('https://images.unsplash.com/photo-1416879595882-3373a0480b5b?auto=format&fit=crop&w=1600&q=80') center 40% / cover no-repeat;
    position: relative;
  }
  .landing::before { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, rgba(0,0,0,0.5) 0%, rgba(1,50,32,0.8) 100%); pointer-events: none; }
  .landing > * { position: relative; z-index: 1; }
  .landing-eyebrow { font-size: 0.62rem; font-weight: 600; letter-spacing: 3px; text-transform: uppercase; color: var(--gold-lite); margin-bottom: 24px; }
  .landing h1 { font-family: 'Playfair Display', serif; font-size: clamp(2.4rem, 5vw, 4rem); font-weight: 900; font-style: italic; line-height: 1.1; margin-bottom: 20px; max-width: 600px; }
  .landing > p { font-size: 1.05rem; font-weight: 300; color: rgba(255,255,255,0.65); line-height: 1.8; max-width: 480px; margin-bottom: 48px; }
  .mode-cards { display: flex; gap: 16px; flex-wrap: wrap; justify-content: center; margin-bottom: 40px; }
  .mode-card { background: rgba(255,255,255,0.04); border: 1.5px solid rgba(255,255,255,0.1); border-radius: 16px; padding: 28px 32px; width: 260px; text-align: left; cursor: pointer; transition: all 0.25s ease; }
  .mode-card:hover { background: rgba(1,50,32,0.35); border-color: rgba(1,100,60,0.5); transform: translateY(-3px); }
  .mode-card h3 { font-family: 'Playfair Display', serif; font-size: 1.2rem; font-weight: 700; font-style: italic; margin-bottom: 6px; }
  .mode-card .mode-time { font-size: 0.7rem; color: var(--gold-lite); letter-spacing: 1px; font-weight: 600; margin-bottom: 10px; }
  .mode-card p { font-size: 0.82rem; color: rgba(255,255,255,0.48); line-height: 1.65; margin-bottom: 0; }
  .trust-row { display: flex; gap: 32px; flex-wrap: wrap; justify-content: center; }
  .trust-item { font-size: 0.72rem; color: rgba(255,255,255,0.32); font-weight: 500; }
  .trust-item span { color: var(--gold-lite); margin-right: 6px; }

  /* ── FULLSCREEN OVERLAY ── */
  .flow-overlay { display: none; position: fixed; inset: 0; z-index: 9999; background: var(--bg-dark); flex-direction: column; }
  .flow-overlay.open { display: flex; }
  .flow-topbar { display: flex; align-items: center; justify-content: space-between; padding: 10px 24px; border-bottom: 1px solid rgba(255,255,255,0.06); flex-shrink: 0; }
  .flow-logo { font-family: 'Playfair Display', serif; font-size: 0.9rem; font-weight: 900; font-style: italic; color: white; }
  .flow-logo small { display: block; font-family: 'DM Sans', sans-serif; font-size: 0.52rem; font-weight: 400; font-style: normal; letter-spacing: 2px; text-transform: uppercase; color: rgba(255,255,255,0.3); margin-top: 2px; }
  .flow-close { background: none; border: 1px solid rgba(255,255,255,0.12); border-radius: 8px; color: rgba(255,255,255,0.4); font-size: 0.72rem; padding: 8px 16px; cursor: pointer; transition: all 0.2s; font-family: 'DM Sans', sans-serif; font-weight: 500; letter-spacing: 0.5px; }
  .flow-close:hover { color: white; border-color: rgba(255,255,255,0.3); }
  .flow-progress { flex-shrink: 0; padding: 0 24px; }
  .flow-progress-bar { height: 2px; background: rgba(255,255,255,0.06); border-radius: 2px; }
  .flow-progress-fill { height: 100%; background: var(--gold); border-radius: 2px; transition: width 0.5s cubic-bezier(0.4,0,0.2,1); width: 0%; }
  .flow-content { flex: 1; display: flex; align-items: center; justify-content: center; overflow-y: auto; padding: 16px 24px; }
  .flow-step { display: none; max-width: 640px; width: 100%; }
  .flow-step.active { display: block; animation: fadeUp 0.3s ease forwards; }
  @keyframes fadeUp { from { opacity:0; transform:translateY(12px); } to { opacity:1; transform:translateY(0); } }
  .flow-step .step-number { font-size: 0.55rem; font-weight: 600; letter-spacing: 2px; text-transform: uppercase; color: var(--gold-lite); margin-bottom: 6px; }
  .flow-step h2 { font-family: 'Playfair Display', serif; font-size: clamp(1.2rem,2.5vw,1.6rem); font-weight: 900; font-style: italic; color: var(--cream); line-height: 1.2; margin-bottom: 4px; }
  .flow-step .step-desc { font-size: 0.78rem; color: rgba(255,255,255,0.42); line-height: 1.5; margin-bottom: 12px; }

  /* ── GRID OPTIONS ── */
  .flow-options { display: grid; grid-template-columns: 1fr 1fr; gap: 6px; margin-bottom: 10px; }
  .flow-options.grid-3 { grid-template-columns: 1fr 1fr 1fr; }
  .flow-option {
    padding: 8px 10px; border-radius: 8px; text-align: left;
    background: rgba(255,255,255,0.03); border: 1.5px solid rgba(255,255,255,0.08);
    color: rgba(255,255,255,0.65); font-family: 'DM Sans', sans-serif;
    font-size: 0.75rem; font-weight: 500; cursor: pointer;
    transition: all 0.2s ease; line-height: 1.25; display: flex; align-items: center; gap: 8px;
  }
  .flow-option:hover { background: rgba(1,50,32,0.3); border-color: rgba(1,100,60,0.5); color: white; }
  .flow-option.selected { background: rgba(1,50,32,0.5); border-color: #4a8c5c; color: white; }
  .flow-option.route-hidden { display: none !important; }
  .flow-option .opt-icon { font-size: 1rem; flex-shrink: 0; }
  .flow-option .opt-label { flex: 1; min-width: 0; }
  .flow-option .opt-sub { font-size: 0.6rem; display: block; opacity: 0.5; margin-top: 1px; font-weight: 400; line-height: 1.2; }

  /* ── CHIP OPTIONS ── */
  .chip-group { margin-bottom: 12px; }
  .chip-group-label { font-size: 0.6rem; font-weight: 600; letter-spacing: 1.5px; text-transform: uppercase; color: rgba(255,255,255,0.22); margin-bottom: 7px; }
  .chip-row { display: flex; flex-wrap: wrap; gap: 6px; }
  .chip {
    display: inline-flex; align-items: center; gap: 7px;
    padding: 9px 16px; border-radius: 100px;
    background: rgba(255,255,255,0.04); border: 1.5px solid rgba(255,255,255,0.1);
    color: rgba(255,255,255,0.6); font-family: 'DM Sans', sans-serif;
    font-size: 0.8rem; font-weight: 500; cursor: pointer;
    transition: all 0.2s ease; white-space: nowrap; -webkit-user-select: none; user-select: none;
  }
  .chip:hover { background: rgba(1,50,32,0.3); border-color: rgba(1,100,60,0.45); color: white; }
  .chip.selected { background: rgba(1,50,32,0.5); border-color: #4a8c5c; color: white; }
  .chip.hidden-chip { display: none !important; }
  .chip .chip-icon { font-size: 0.95rem; line-height: 1; }
  .chip-group.hidden-group { display: none !important; }

  .context-badge { display: inline-block; font-size: 0.55rem; font-weight: 600; letter-spacing: 1px; text-transform: uppercase; color: rgba(255,255,255,0.2); background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.06); border-radius: 100px; padding: 3px 10px; margin-bottom: 10px; }
  .context-badge span { color: var(--gold-lite); }
  .multi-hint { font-size: 0.68rem; color: rgba(255,255,255,0.3); margin-bottom: 10px; }
  .multi-hint .count { color: var(--gold-lite); font-weight: 600; }

  .flow-btn { width: 100%; padding: 12px; border-radius: 10px; background: var(--gold); color: var(--forest); font-family: 'DM Sans', sans-serif; font-size: 0.75rem; font-weight: 700; letter-spacing: 1.5px; text-transform: uppercase; border: none; cursor: pointer; transition: background 0.2s, transform 0.15s; margin-top: 6px; }
  .flow-btn:hover { background: var(--gold-lite); transform: translateY(-1px); }
  .flow-btn.ghost { background: transparent; color: rgba(255,255,255,0.35); border: 1.5px solid rgba(255,255,255,0.1); margin-top: 8px; }
  .flow-btn.ghost:hover { color: rgba(255,255,255,0.65); border-color: rgba(255,255,255,0.25); transform: none; }

  .flow-form-group { margin-bottom: 10px; }
  .flow-form-group label { display: block; font-size: 0.65rem; font-weight: 600; letter-spacing: 1px; text-transform: uppercase; color: rgba(255,255,255,0.35); margin-bottom: 5px; }
  .flow-form-group input, .flow-form-group textarea { width: 100%; padding: 10px 14px; border-radius: 10px; background: rgba(255,255,255,0.05); border: 1.5px solid rgba(255,255,255,0.1); color: white; font-family: 'DM Sans', sans-serif; font-size: 0.85rem; outline: none; transition: border-color 0.2s; }
  .flow-form-group input:focus, .flow-form-group textarea:focus { border-color: #4a8c5c; }
  .flow-form-group textarea { resize: vertical; min-height: 60px; }
  .flow-form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
  .form-error { display: none; color: #e07070; font-size: 0.78rem; text-align: center; margin-top: 10px; }

  .result-card { background: rgba(1,50,32,0.22); border: 1px solid rgba(1,80,48,0.4); border-radius: 14px; padding: 24px; text-align: center; margin-bottom: 16px; }
  .result-badge { display: inline-block; background: var(--gold); color: var(--bg-dark); font-size: 0.55rem; font-weight: 700; letter-spacing: 2px; text-transform: uppercase; padding: 4px 14px; border-radius: 100px; margin-bottom: 10px; }
  .result-price { font-family: 'Playfair Display', serif; font-size: 2.6rem; font-weight: 900; color: white; line-height: 1; }
  .result-price sup { font-size: 1rem; vertical-align: super; margin-right: 2px; }
  .result-price .unit { font-size: 0.85rem; font-weight: 400; opacity: 0.5; }
  .result-season { font-size: 0.68rem; color: rgba(255,255,255,0.36); letter-spacing: 1px; text-transform: uppercase; margin-top: 6px; }
  .result-annual { font-size: 0.8rem; color: var(--gold-lite); margin-top: 6px; }

  .flow-bottombar { flex-shrink: 0; padding: 10px 24px; border-top: 1px solid rgba(255,255,255,0.06); display: flex; align-items: center; justify-content: space-between; }
  .flow-step-label { font-size: 0.68rem; color: rgba(255,255,255,0.25); letter-spacing: 1px; text-transform: uppercase; }
  .flow-back-btn { background: none; border: none; color: rgba(255,255,255,0.3); font-family: 'DM Sans', sans-serif; font-size: 0.78rem; cursor: pointer; padding: 8px 16px; transition: color 0.2s; }
  .flow-back-btn:hover { color: rgba(255,255,255,0.7); }
  .flow-back-btn.hidden { opacity: 0; pointer-events: none; }

  @media (max-width: 600px) {
    .flow-options { grid-template-columns: 1fr 1fr; }
    .flow-options.grid-3 { grid-template-columns: 1fr 1fr; }
    .flow-form-row { grid-template-columns: 1fr; }
    .mode-cards { flex-direction: column; align-items: center; }
    .mode-card { width: 100%; max-width: 340px; }
    .flow-content { padding: 12px 16px; }
    .flow-step h2 { font-size: 1.15rem; }
    .flow-option { padding: 7px 8px; font-size: 0.7rem; gap: 6px; }
    .flow-option .opt-icon { font-size: 0.9rem; }
    .flow-option .opt-sub { display: none; }
    .chip { padding: 7px 12px; font-size: 0.72rem; }
    .chip .chip-icon { font-size: 0.82rem; }
    .trust-row { gap: 16px; }
  }
</style>

<!-- ══════════ LANDING ══════════ -->
<div class="landing" id="landing">
  <div class="landing-eyebrow">Begin Your Consultation</div>
  <h1>Let's Build Your Stewardship Plan</h1>
  <p>Tell us about your land. We'll tell you what it can become — and build a program to get it there.</p>
  <div class="mode-cards">
    <div class="mode-card" id="btn-qq"><h3>Quick Quote</h3><div class="mode-time">~4 minutes · estimate range</div><p>Answer a few questions and get a ballpark estimate for your property. Great if you're exploring.</p></div>
    <div class="mode-card" id="btn-dd"><h3>Full Discovery</h3><div class="mode-time">~8 minutes · custom profile</div><p>A deeper dive that generates your full stewardship profile with service comparison and 3-year roadmap.</p></div>
  </div>
  <div class="trust-row">
    <div class="trust-item"><span>✓</span> Free on-site assessment</div>
    <div class="trust-item"><span>✓</span> Response within 24 hours</div>
    <div class="trust-item"><span>✓</span> No commitment required</div>
    <div class="trust-item"><span>✓</span> Residential, farm & commercial</div>
    <div class="trust-item"><span>✓</span> Programs built to improve every year</div>
  </div>
</div>

<!-- ══════════ FULLSCREEN FLOW ══════════ -->
<div class="flow-overlay" id="flowOverlay">
  <div class="flow-topbar">
    <div class="flow-logo">Filthy Rich Soil Co.<small>Chester County, PA</small></div>
    <button class="flow-close" id="btn-close">Save & Exit</button>
  </div>
  <div class="flow-progress"><div class="flow-progress-bar"><div class="flow-progress-fill" id="progressFill"></div></div></div>

  <div class="flow-content" id="flowContent">

    <!-- ══ SHARED: Step 1 — Property Type ══ -->
    <div class="flow-step active" id="fs-type">
      <div class="step-number" id="sn-type">Step 1</div>
      <h2>What kind of property is this?</h2>
      <div class="step-desc">Helps us tailor everything that follows.</div>
      <div class="flow-options">
        <button class="flow-option" data-action="select-type" data-val="residential" data-next="fs-size-res"><span class="opt-icon">🏠</span><span class="opt-label">Residential home</span></button>
        <button class="flow-option" data-action="select-type" data-val="farm" data-next="fs-size-land"><span class="opt-icon">🌾</span><span class="opt-label">Farm or working land</span></button>
        <button class="flow-option" data-action="select-type" data-val="commercial" data-next="fs-size-com"><span class="opt-icon">🏢</span><span class="opt-label">Commercial property</span></button>
        <button class="flow-option" data-action="select-type" data-val="estate" data-next="fs-size-land"><span class="opt-icon">🌳</span><span class="opt-label">Estate / large residential</span></button>
      </div>
    </div>

    <!-- ══ SHARED: Step 2a — Size (Residential) ══ -->
    <div class="flow-step" id="fs-size-res">
      <div class="step-number">Step 2</div>
      <h2>How large is the property?</h2>
      <div class="step-desc">Approximate is fine — we confirm on-site.</div>
      <div class="flow-options grid-3">
        <button class="flow-option" data-action="select-size" data-val="small"><span class="opt-icon">🏠</span><span class="opt-label">Under ¼ acre</span></button>
        <button class="flow-option" data-action="select-size" data-val="quarter"><span class="opt-icon">🏘️</span><span class="opt-label">¼ – ½ acre</span></button>
        <button class="flow-option" data-action="select-size" data-val="half"><span class="opt-icon">🌳</span><span class="opt-label">½ – 1 acre</span></button>
        <button class="flow-option" data-action="select-size" data-val="acre"><span class="opt-icon">🗺️</span><span class="opt-label">1 – 3 acres</span></button>
        <button class="flow-option" data-action="select-size" data-val="large"><span class="opt-icon">🏔️</span><span class="opt-label">3 – 5 acres</span></button>
      </div>
    </div>

    <!-- ══ SHARED: Step 2b — Size (Commercial) ══ -->
    <div class="flow-step" id="fs-size-com">
      <div class="step-number">Step 2</div>
      <h2>How large is the property?</h2>
      <div class="step-desc">Approximate is fine — we confirm on-site.</div>
      <div class="flow-options grid-3">
        <button class="flow-option" data-action="select-size" data-val="small"><span class="opt-icon">🏠</span><span class="opt-label">Under ¼ acre</span></button>
        <button class="flow-option" data-action="select-size" data-val="quarter"><span class="opt-icon">🏘️</span><span class="opt-label">¼ – ½ acre</span></button>
        <button class="flow-option" data-action="select-size" data-val="half"><span class="opt-icon">🌳</span><span class="opt-label">½ – 1 acre</span></button>
        <button class="flow-option" data-action="select-size" data-val="acre"><span class="opt-icon">🗺️</span><span class="opt-label">1 – 3 acres</span></button>
        <button class="flow-option" data-action="select-size" data-val="large"><span class="opt-icon">🏔️</span><span class="opt-label">3 – 5 acres</span></button>
        <button class="flow-option" data-action="select-size" data-val="acres5"><span class="opt-icon">🌿</span><span class="opt-label">5+ acres</span></button>
      </div>
    </div>

    <!-- ══ SHARED: Step 2c — Size (Estate / Farm) ══ -->
    <div class="flow-step" id="fs-size-land">
      <div class="step-number">Step 2</div>
      <h2>How large is the property?</h2>
      <div class="step-desc">Approximate is fine — we confirm on-site.</div>
      <div class="flow-options grid-3">
        <button class="flow-option" data-action="select-size" data-val="acres5"><span class="opt-icon">🌿</span><span class="opt-label">5 – 10 acres</span></button>
        <button class="flow-option" data-action="select-size" data-val="acres10"><span class="opt-icon">🏔️</span><span class="opt-label">10 – 25 acres</span></button>
        <button class="flow-option" data-action="select-size" data-val="acres25"><span class="opt-icon">🗺️</span><span class="opt-label">25 – 50 acres</span></button>
        <button class="flow-option" data-action="select-size" data-val="acres50"><span class="opt-icon">🌾</span><span class="opt-label">50 – 100 acres</span></button>
        <button class="flow-option" data-action="select-size" data-val="acres100"><span class="opt-icon">🚜</span><span class="opt-label">100+ acres</span></button>
      </div>
    </div>

    <!-- ══ DD ONLY: Land Use ══ -->
    <div class="flow-step" id="fs-landuse">
      <div class="step-number">Step 3 of 11</div>
      <h2>How is this land currently used?</h2>
      <div class="step-desc">Tells us which program categories apply.</div>
      <div class="flow-options">
        <button class="flow-option" data-action="select" data-key="landuse" data-val="lawn" data-next="fs-challenges" data-route="residential estate"><span class="opt-icon">🌿</span><span class="opt-label">Lawn & manicured gardens<span class="opt-sub">Turf, beds, ornamentals</span></span></button>
        <button class="flow-option" data-action="select" data-key="landuse" data-val="garden" data-next="fs-challenges" data-route="residential"><span class="opt-icon">🌺</span><span class="opt-label">Mostly garden beds<span class="opt-sub">Little to no lawn</span></span></button>
        <button class="flow-option" data-action="select" data-key="landuse" data-val="mixed" data-next="fs-challenges" data-route="residential estate farm"><span class="opt-icon">🌳</span><span class="opt-label">Mixed yard + naturalized<span class="opt-sub">Some cultivated, some wild</span></span></button>
        <button class="flow-option" data-action="select" data-key="landuse" data-val="wooded" data-next="fs-challenges" data-route="residential estate"><span class="opt-icon">🌲</span><span class="opt-label">Wooded or naturalized<span class="opt-sub">Mostly trees, shrubs, wild growth</span></span></button>
        <button class="flow-option" data-action="select" data-key="landuse" data-val="pasture" data-next="fs-challenges" data-route="farm estate"><span class="opt-icon">🐄</span><span class="opt-label">Active pasture / livestock<span class="opt-sub">Horses, cattle, sheep, etc.</span></span></button>
        <button class="flow-option" data-action="select" data-key="landuse" data-val="hay" data-next="fs-challenges" data-route="farm estate"><span class="opt-icon">🌾</span><span class="opt-label">Hay field / field crops<span class="opt-sub">Cut fields, crop rotation</span></span></button>
        <button class="flow-option" data-action="select" data-key="landuse" data-val="orchard" data-next="fs-challenges" data-route="estate"><span class="opt-icon">🍎</span><span class="opt-label">Orchard or food-producing<span class="opt-sub">Fruit, nut, or kitchen garden</span></span></button>
        <button class="flow-option" data-action="select" data-key="landuse" data-val="workfarm" data-next="fs-challenges" data-route="farm"><span class="opt-icon">🚜</span><span class="opt-label">Working farm (mixed use)<span class="opt-sub">Livestock + hay + gardens</span></span></button>
        <button class="flow-option" data-action="select" data-key="landuse" data-val="commercial" data-next="fs-challenges" data-route="commercial"><span class="opt-icon">🏢</span><span class="opt-label">Commercial / institutional<span class="opt-sub">Business grounds or HOA</span></span></button>
        <button class="flow-option" data-action="select" data-key="landuse" data-val="comnat" data-next="fs-challenges" data-route="commercial"><span class="opt-icon">🌱</span><span class="opt-label">Commercial + naturalized<span class="opt-sub">Green corridors, native buffers</span></span></button>
      </div>
    </div>

    <!-- ══ DD ONLY: Challenges (expanded) ══ -->
    <div class="flow-step" id="fs-challenges">
      <div class="step-number">Step 4 of 11</div>
      <h2>What challenges are you dealing with?</h2>
      <div class="context-badge" id="challBadge"><span>🏠</span> Tailored for residential</div>
      <div class="multi-hint">Confidential — helps us prepare. <span class="count" id="challCount">0</span> selected</div>
      <div id="chall-groups">
        <div class="chip-group" data-group="chall-soil">
          <div class="chip-group-label">Soil & Turf</div>
          <div class="chip-row">
            <button class="chip" data-action="chip-toggle" data-set="challenges" data-val="turfpoor"><span class="chip-icon">😞</span> Poor turf or bare patches</button>
            <button class="chip" data-action="chip-toggle" data-set="challenges" data-val="compaction"><span class="chip-icon">🪨</span> Compaction / hard clay</button>
            <button class="chip" data-action="chip-toggle" data-set="challenges" data-val="inputs"><span class="chip-icon">🧪</span> High fertilizer / chemical costs</button>
          </div>
        </div>
        <div class="chip-group" data-group="chall-water">
          <div class="chip-group-label">Water & Plantings</div>
          <div class="chip-row">
