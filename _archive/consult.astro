        <button class="flow-option" data-action="select" data-key="timeline" data-val="season" data-next="fs-savings"><span class="opt-icon">📅</span><span class="opt-label">This season</span></button>
        <button class="flow-option" data-action="select" data-key="timeline" data-val="next" data-next="fs-savings"><span class="opt-icon">🌤️</span><span class="opt-label">Next season</span></button>
        <button class="flow-option" data-action="select" data-key="timeline" data-val="exploring" data-next="fs-savings"><span class="opt-icon">💭</span><span class="opt-label">Just exploring</span></button>
      </div>
    </div>

    <!-- ══ SHARED: Partnerships ══ -->
    <div class="flow-step" id="fs-savings">
      <div class="step-number" id="sn-savings">Step 6 of 7</div>
      <h2>Would you consider a partnership?</h2>
      <div class="step-desc">Each earns a rate reduction — terms confirmed on your consultation call.</div>
      <div class="multi-hint">Select all that interest you — <span class="count" id="savCount">0</span> selected</div>
      <div class="flow-options">
        <button class="flow-option" data-action="toggle" data-set="savings" data-val="trainees" data-counter="savCount"><span class="opt-icon">👥</span><span class="opt-label">Stewards in Training<span class="opt-sub">Supervised trainees join your senior Steward</span></span></button>
        <button class="flow-option" data-action="toggle" data-set="savings" data-val="content" data-counter="savCount"><span class="opt-icon">📸</span><span class="opt-label">Property as Content<span class="opt-sub">We document the transformation for media</span></span></button>
        <button class="flow-option" data-action="toggle" data-set="savings" data-val="pilot" data-counter="savCount"><span class="opt-icon">🔬</span><span class="opt-label">Pilot Program<span class="opt-sub">Living lab for new techniques on your land</span></span></button>
        <button class="flow-option" data-action="toggle" data-set="savings" data-val="flexible" data-counter="savCount"><span class="opt-icon">📅</span><span class="opt-label">Full Schedule Flex<span class="opt-sub">No day restrictions — most efficient route</span></span></button>
      </div>
      <button class="flow-btn" id="btn-savings-continue">Continue →</button>
    </div>

    <!-- ══ DD ONLY: Decision Maker ══ -->
    <div class="flow-step" id="fs-decision">
      <div class="step-number">Step 12 of 13</div>
      <h2>Who makes property decisions?</h2>
      <div class="step-desc">Helps us structure our proposal and follow-up.</div>
      <div class="flow-options">
        <button class="flow-option" data-action="select" data-key="decision" data-val="sole" data-next="fs-dd-contact"><span class="opt-icon">👤</span><span class="opt-label">I own it — sole decision<span class="opt-sub">Personal or business owner</span></span></button>
        <button class="flow-option" data-action="select" data-key="decision" data-val="joint" data-next="fs-dd-contact"><span class="opt-icon">👫</span><span class="opt-label">Joint family decision<span class="opt-sub">Spouse, partner, or family</span></span></button>
        <button class="flow-option" data-action="select" data-key="decision" data-val="manager" data-next="fs-dd-contact"><span class="opt-icon">📋</span><span class="opt-label">Property or farm manager<span class="opt-sub">Managing on behalf of owner</span></span></button>
        <button class="flow-option" data-action="select" data-key="decision" data-val="hoa" data-next="fs-dd-contact"><span class="opt-icon">🏘️</span><span class="opt-label">HOA / board approval needed<span class="opt-sub">Requires committee sign-off</span></span></button>
      </div>
    </div>

    <!-- ══ QQ: Contact ══ -->
    <div class="flow-step" id="fs-qq-contact">
      <div class="step-number">Step 8 of 8</div>
      <h2>Where should we send your profile?</h2>
      <div class="step-desc">A Lead Steward follows up personally — no automated sequences, no spam.</div>
      <div class="flow-form-row">
        <div class="flow-form-group"><label>First Name</label><input type="text" id="qqFirst" placeholder="Jane"></div>
        <div class="flow-form-group"><label>Last Name</label><input type="text" id="qqLast" placeholder="Smith"></div>
      </div>
      <div class="flow-form-group"><label>Email Address</label><input type="email" id="qqEmail" placeholder="jane@email.com"></div>
      <div class="flow-form-group"><label>Phone (optional)</label><input type="tel" id="qqPhone" placeholder="(610) 555-0100"></div>
      <div class="flow-form-group"><label>Town or municipality</label><input type="text" id="qqTown" placeholder="Malvern, PA"></div>
      <p class="form-error" id="qqErr">Please enter your name and email so your Lead Steward can reach you.</p>
      <button class="flow-btn" id="btn-qq-generate">Generate My Profile →</button>
    </div>

    <!-- ══ DD: Contact (expanded) ══ -->
    <div class="flow-step" id="fs-dd-contact">
      <div class="step-number">Step 13 of 13</div>
      <h2>Let's build your stewardship profile</h2>
      <div class="step-desc">Almost ready — we'll generate your full custom document.</div>
      <div class="flow-form-row">
        <div class="flow-form-group"><label>First Name</label><input type="text" id="ddFirst" placeholder="Jane"></div>
        <div class="flow-form-group"><label>Last Name</label><input type="text" id="ddLast" placeholder="Smith"></div>
      </div>
      <div class="flow-form-group"><label>Email Address</label><input type="email" id="ddEmail" placeholder="jane@email.com"></div>
      <div class="flow-form-group"><label>Phone (optional)</label><input type="tel" id="ddPhone" placeholder="(610) 555-0100"></div>
      <div class="flow-form-group"><label>Property address or town</label><input type="text" id="ddAddr" placeholder="123 Farm Rd, Malvern, PA"></div>
      <div class="flow-form-group"><label>Anything else we should know? (optional)</label><textarea id="ddNotes" rows="3" placeholder="Specific history, challenges, or context about the property..."></textarea></div>
      <p class="form-error" id="ddErr">Please enter your name and email so your Lead Steward can reach you.</p>
      <button class="flow-btn" id="btn-dd-generate">Generate My Profile →</button>
    </div>

    <!-- ══ SHARED: Result ══ -->
    <div class="flow-step" id="fs-result">

      <!-- Program name + personalized greeting -->
      <div style="text-align:center;margin-bottom:16px;">
        <div style="font-size:0.55rem;font-weight:600;letter-spacing:3px;text-transform:uppercase;color:var(--gold-lite);margin-bottom:6px;">Putting Down Roots</div>
        <h2 style="font-family:'Playfair Display',serif;font-size:clamp(1.3rem,2.8vw,1.7rem);font-weight:900;font-style:italic;color:var(--cream);line-height:1.2;margin-bottom:4px;">Your program is ready, <span id="resultName">there</span>.</h2>
        <p style="font-size:0.78rem;color:rgba(255,255,255,0.4);margin:0;">Here's what we built based on your answers.</p>
      </div>

      <!-- Selections reflected -->
      <div id="resultSelections" style="display:flex;flex-wrap:wrap;gap:6px;justify-content:center;margin-bottom:16px;">
        <span class="result-tag" id="resultTypeTag"></span>
        <span class="result-tag" id="resultSizeTag"></span>
        <span id="resultPriorityTags" style="display:contents;"></span>
      </div>

      <!-- Estimate card -->
      <div class="result-card">
        <span class="result-badge">Your Estimate</span>
        <div class="result-price"><sup>$</sup><span id="resultWeekly">155</span><span class="unit">/week</span></div>
        <div class="result-season">Based on a 36-week season</div>
        <div class="result-annual" id="resultAnnual"></div>
      </div>

      <!-- What's included -->
      <div style="background:rgba(1,50,32,0.15);border:1px solid rgba(1,80,48,0.3);border-radius:10px;padding:14px 16px;margin-bottom:12px;">
        <div style="font-size:0.6rem;font-weight:600;letter-spacing:1.5px;text-transform:uppercase;color:var(--gold-lite);margin-bottom:8px;">Included every week</div>
        <div style="display:flex;flex-direction:column;gap:5px;">
          <div class="result-include-row"><span style="color:#5fa870;margin-right:8px;font-size:0.8rem;">✓</span> Lawn mowing (biological practices)</div>
          <div class="result-include-row"><span style="color:#5fa870;margin-right:8px;font-size:0.8rem;">✓</span> Full-land sustainable fertilization</div>
          <div class="result-include-row"><span style="color:#5fa870;margin-right:8px;font-size:0.8rem;">✓</span> Invasive species management</div>
          <div class="result-include-row"><span style="color:#5fa870;margin-right:8px;font-size:0.8rem;">✓</span> Weed-free bed maintenance</div>
          <div class="result-include-row"><span style="color:#5fa870;margin-right:8px;font-size:0.8rem;">✓</span> Dedicated Lead Steward</div>
        </div>
        <div id="resultAddons" style="display:none;margin-top:8px;padding-top:8px;border-top:1px solid rgba(255,255,255,0.06);">
          <div style="font-size:0.58rem;font-weight:600;letter-spacing:1px;text-transform:uppercase;color:rgba(255,255,255,0.3);margin-bottom:5px;">Add-ons you selected — scoped on-site</div>
          <div id="resultAddonList" style="display:flex;flex-wrap:wrap;gap:5px;"></div>
        </div>
      </div>

      <!-- What happens next -->
      <div style="background:rgba(184,134,11,0.06);border:1px solid rgba(184,134,11,0.18);border-radius:10px;padding:14px 16px;margin-bottom:14px;">
        <div style="font-size:0.6rem;font-weight:600;letter-spacing:1.5px;text-transform:uppercase;color:var(--gold-lite);margin-bottom:10px;">What happens next</div>
        <div class="result-next-step">
          <div class="result-next-num">1</div>
          <div><strong style="color:var(--cream);font-size:0.82rem;">Your Lead Steward reaches out</strong><br><span style="font-size:0.72rem;color:rgba(255,255,255,0.4);">A real call or email within 24 hours — not an automated sequence.</span></div>
        </div>
        <div class="result-next-step">
          <div class="result-next-num">2</div>
          <div><strong style="color:var(--cream);font-size:0.82rem;">Free on-site soil assessment</strong><br><span style="font-size:0.72rem;color:rgba(255,255,255,0.4);">They walk the property with you. Soil samples, drainage, plant health.</span></div>
        </div>
        <div class="result-next-step">
          <div class="result-next-num">3</div>
          <div><strong style="color:var(--cream);font-size:0.82rem;">Your custom proposal</strong><br><span style="font-size:0.72rem;color:rgba(255,255,255,0.4);">Ecological goals, services, schedule, and your all-inclusive number.</span></div>
        </div>
      </div>

      <!-- Profile button -->
      <button class="flow-btn" id="btn-profile">Open Your Stewardship Profile →</button>
      <p style="font-size:0.78rem;color:#5fa870;font-weight:600;text-align:center;margin:10px 0 4px;letter-spacing:0.3px;">✓ Details sent to your Lead Steward</p>

      <!-- Guarantee + legal -->
      <div style="text-align:center;margin-top:10px;">
        <p style="font-size:0.72rem;color:rgba(255,255,255,0.35);line-height:1.5;margin:0 0 6px;">No commitment required. Free assessment. You decide — no pressure.</p>
        <p style="font-size:0.58rem;color:rgba(255,255,255,0.18);line-height:1.5;margin:0;">Estimate is informational, not a binding offer. Final pricing confirmed after on-site assessment. By submitting you agree to our <a href="/privacy" style="color:rgba(255,255,255,0.25);text-decoration:underline;">Privacy Policy</a> & <a href="/terms" style="color:rgba(255,255,255,0.25);text-decoration:underline;">Terms</a>.</p>
      </div>
      <button class="flow-btn ghost" id="btn-done" style="margin-top:10px;">Done</button>
    </div>

  </div>

  <div class="flow-bottombar">
    <button class="flow-back-btn hidden" id="backBtn">← Back</button>
    <div class="flow-step-label" id="stepLabel">Step 1</div>
  </div>
</div>


<script>
  import { initializeEventHandlers } from '../scripts/event-handlers.js';
  initializeEventHandlers();
</script>

</Base>
